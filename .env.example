# Copy to .env at the repo root and fill in. Never commit .env.
# Every value is server-only unless marked PUBLIC. In production (Cloud Run) the secrets come from Secret Manager
# instead (docs/DEPLOYMENT.md). Generate a random secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Required ---------------------------------------------------------------------------------------------------

# Anthropic API key for the agent (Claude Agent SDK)
ANTHROPIC_API_KEY=

# Supabase Postgres via the SESSION pooler (IPv4): Supabase → Connect → Session pooler.
# URL-encode special characters in the password. Used by the app, relaypay-db and the CLIs.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Which tables: public = the real records; test = a throwaway copy with its own ticket numbers
# (create it once with DATABASE_SCHEMA=test poetry run relaypay-db). Evaluations only run on test.
DATABASE_SCHEMA=public

# Shared secret Vapi sends with every request (header X-RelayPay-Secret, or Authorization: Bearer).
# At least 32 characters; set the same value in the Vapi assistant's Custom LLM and server headers.
VAPI_LLM_SECRET=

# Bearer token between the agent and the MCP server. At least 32 characters, different from VAPI_LLM_SECRET.
MCP_AUTH_TOKEN=

# --- Voice page (optional: without them the page loads but can't start a call) -----------------------------------

# PUBLIC: Vapi's public key and the assistant ID; both are safe in the browser
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=

# --- Support console (optional: without the secret the console is switched off) ----------------------------------

# Signs the console session cookie. At least 32 characters.
# Create the owner account with: poetry run relaypay-admin --email you@example.com
CONSOLE_SESSION_SECRET=
# Base of invite and reset links, e.g. https://<your-service-url> (if empty, taken from the request)
PUBLIC_BASE_URL=

# --- Agent (defaults shown) ---------------------------------------------------------------------------------------

AGENT_MODEL=claude-haiku-4-5-20251001
# Model steps per caller message (caps tool loops and cost)
AGENT_MAX_TURNS=6
# Seconds before an unanswered turn gets the technical-problem line (must stay under Vapi's 20 s)
AGENT_TURN_TIMEOUT_SECONDS=15
# An idle call's session is closed after this (longer than Vapi's 120 s silence hang-up)
AGENT_SESSION_IDLE_SECONDS=180
# Calls at once; extra callers hear the "very busy" line. About 1 GiB of memory per call (3 on Cloud Run's 4 GiB).
AGENT_MAX_SESSIONS=10

# --- Server (defaults shown) --------------------------------------------------------------------------------------

# 127.0.0.1 locally; 0.0.0.0 in a container (the Dockerfile sets it, and PORT=8080)
HOST=127.0.0.1
PORT=8000
# The MCP server always stays on localhost, inside the same process
MCP_HOST=127.0.0.1
MCP_PORT=8001
KB_PATH=data/relaypay-knowledge-base.md

# --- Logging (defaults shown) -------------------------------------------------------------------------------------

LOG_LEVEL=INFO
# text locally; json on Cloud Run (one JSON object per line, for Cloud Logging)
LOG_FORMAT=text
# Optional: also write the log to this file (local testing; logs/ is gitignored). Leave empty in a container.
LOG_FILE=
# Only used by the standalone MCP server when there's no DATABASE_URL (otherwise searches are logged to Supabase)
RETRIEVAL_LOG_PATH=logs/retrieval.jsonl
