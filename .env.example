# Copy to .env at the repo root and fill in. Never commit .env.
# Server-only unless marked PUBLIC.

# --- Anthropic / agent ---
ANTHROPIC_API_KEY=
# Model the agent uses (decided by the latency test), e.g. claude-haiku-4-5-20251001, claude-sonnet-5
AGENT_MODEL=claude-haiku-4-5-20251001
# Max agent turns per caller message (caps tool loops and cost)
AGENT_MAX_TURNS=6
# Seconds before an unanswered turn is abandoned with the technical-problem line (must stay under Vapi's 20 s)
AGENT_TURN_TIMEOUT_SECONDS=15
# Backend closes an idle call session after this (longer than Vapi's 120 s silence hang-up)
AGENT_SESSION_IDLE_SECONDS=180
# Maximum concurrent calls; extra callers hear the "very busy" line
AGENT_MAX_SESSIONS=10

# --- Vapi ---
# Shared secret Vapi sends in the Authorization header to /chat/completions
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"  (different value from MCP_AUTH_TOKEN)
VAPI_LLM_SECRET=
# PUBLIC: safe in the browser (voice page)
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
# Optional: only to pull call logs / latency from the Vapi API
VAPI_PRIVATE_KEY=

# --- Supabase (Postgres via the SESSION pooler, IPv4) ---
# One connection string for the app, migrations and seeding. Server-only.
# Supabase → Connect → Session pooler. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# --- MCP server (Streamable HTTP, localhost only) ---
# Shared secret the agent sends as "Authorization: Bearer <token>". At least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=
# Keep 127.0.0.1 so the MCP server is never reachable from outside the machine/container
MCP_HOST=127.0.0.1
MCP_PORT=8001
# Where retrieval records go until Supabase (Phase 2). Gitignored.
RETRIEVAL_LOG_PATH=logs/retrieval.jsonl

# --- Knowledge base ---
# Path to the KB markdown, relative to the repo root
KB_PATH=data/relaypay-knowledge-base.md

# --- Support console ---
CONSOLE_PASSWORD=

# --- Server (public app) ---
# 127.0.0.1 locally (ngrok connects locally); 0.0.0.0 on Cloud Run
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
