# Copy to .env at the repo root and fill in. Never commit .env.
# Server-only unless marked PUBLIC.

# --- Anthropic / agent ---
ANTHROPIC_API_KEY=
# Model the agent uses (decided by the latency test), e.g. claude-haiku-4-5-20251001, claude-sonnet-5
AGENT_MODEL=claude-haiku-4-5-20251001
# Max agent turns per reply (caps tool loops and cost)
AGENT_MAX_TURNS=6

# --- Vapi ---
# Shared secret Vapi sends in the Authorization header to /chat/completions
VAPI_LLM_SECRET=
# PUBLIC: safe in the browser (voice page)
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
# Optional: only to pull call logs / latency from the Vapi API
VAPI_PRIVATE_KEY=

# --- Supabase (Postgres via the SESSION pooler, IPv4) ---
# One connection string for the app, migrations and seeding. Server-only.
# Supabase → Connect → Session pooler. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# --- Knowledge base ---
# Path to the KB markdown, relative to the repo root
KB_PATH=data/relaypay-knowledge-base.md

# --- Support console ---
CONSOLE_PASSWORD=

# --- Server ---
PORT=8000
LOG_LEVEL=INFO
